# Database (sqlite for MVP)
DATABASE_URL=sqlite:///./data/db.sqlite

# Redis for Celery
REDIS_URL=redis://redis:6379/0

# Storage path inside container
STORAGE_PATH=/storage

# Optional: model name for faster-whisper (adjust if you have GPU)
WHISPER_MODEL=small

# --- Détection virale par IA (optionnel mais recommandé) ---
# Configure UNE SEULE de ces clés pour activer le vrai scoring par LLM
# (OpenClip) au lieu de l'heuristique de densité de mots. Sans clé, le site
# fonctionne quand même, juste avec un scoring plus basique.
# QWEN_API_KEY=
# GLM_API_KEY=
# MINIMAX_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_MODEL=gpt-4o-mini
